---
interface Props {
  profile: {
    name: string;
    institution: string;
    email: string;
    linkedinUrl?: string;
    whatsappUrl?: string;
    cvUrl?: string;
    driveFolderUrl: string;
    githubProfileUrl: string;
  };
  designCount: number;
}
const { profile, designCount } = Astro.props;
---
<section id="kontak" class="contact-section spotlight-card">
  <div class="contact-left">
    <div class="section-index-row">
      <span class="section-index-num">03</span>
      <span class="section-index-tag">INITIATE COLLABORATION // DIRECT CONTACT</span>
    </div>
    <h2 class="discipline-title">Mari Berkolaborasi <span class="serif-italic">Bersama</span></h2>
    <p class="contact-desc">
      Terbuka untuk peluang karier profesional, komisi desain visual, maupun pengembangan sistem perangkat lunak pada bidang <strong>Graphic Designer</strong> dan <strong>Software Development</strong>.
    </p>
  </div>
  <div class="contact-actions">
    <a id="contactEmailBtn" href={`mailto:${profile.email}`} class="repo-link-btn magnetic-btn">
      Email: {profile.email} &nearr;
    </a>
    <a id="contactGithubBtn" href={profile.githubProfileUrl} target="_blank" rel="noopener noreferrer" class="magnetic-btn magnetic-secondary">
      GitHub (@alkhairan18) &nearr;
    </a>
    <a id="contactDriveBtn" href={profile.driveFolderUrl} target="_blank" rel="noopener noreferrer" class="magnetic-btn magnetic-secondary">
      Google Drive ({designCount} Karya) &nearr;
    </a>
    <a id="contactLinkedinBtn" href={profile.linkedinUrl || '#'} target="_blank" rel="noopener noreferrer" class="magnetic-btn magnetic-secondary" style={profile.linkedinUrl ? 'display:inline-flex;' : 'display:none;'}>
      LinkedIn &nearr;
    </a>
    <a id="contactWhatsappBtn" href={profile.whatsappUrl || '#'} target="_blank" rel="noopener noreferrer" class="magnetic-btn magnetic-secondary" style={profile.whatsappUrl ? 'display:inline-flex;' : 'display:none;'}>
      WhatsApp &nearr;
    </a>
    <a id="contactCvBtn" href={profile.cvUrl || '#'} target="_blank" rel="noopener noreferrer" class="repo-link-btn" style={profile.cvUrl ? 'display:inline-flex;' : 'display:none;'}>
      Unduh CV (PDF) &nearr;
    </a>
  </div>
</section>

<footer class="site-footer">
  <div class="footer-brand-col">
    <strong>{profile.name}</strong> &middot; {profile.institution}
    <span class="footer-edition">2026 STUDIO EDITION // ALL RIGHTS RESERVED</span>
  </div>
  <div class="footer-links">
    <a href={`mailto:${profile.email}`}>
      {profile.email}
    </a>
    <a href={profile.driveFolderUrl} target="_blank" rel="noopener noreferrer">
      Google Drive &nearr;
    </a>
    <a href="https://github.com/alkhairan18/rubooth" target="_blank" rel="noopener noreferrer">
      RUBOOTH &nearr;
    </a>
    <a href={profile.githubProfileUrl} target="_blank" rel="noopener noreferrer">
      GitHub &nearr;
    </a>
  </div>
</footer>
