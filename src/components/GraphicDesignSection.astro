---
interface DriveFilter {
  key: string;
  label: string;
}
interface DriveItem {
  id: string;
  cat: string;
  subcat: string;
  isNew: boolean;
  tool: string;
  type: string;
  title: string;
  file: string;
  desc: string;
}
interface Props {
  filters: DriveFilter[];
  items: DriveItem[];
}
const { filters, items } = Astro.props;
const firstItem = items[0];
---
<section id="bagian-desain" class="discipline-section">
  <div class="discipline-header">
    <div class="discipline-header-top">
      <div class="discipline-title-stack">
        <h2 class="discipline-title">Graphic Designer</h2>
        <p class="discipline-lead">
          Kumpulan 39 karya desain grafis dan multimedia, meliputi infografis resmi KPU Kota Makassar, desain kemasan, ilustrasi vektor, hingga motion graphics dan 3D.
        </p>
      </div>

      <div class="gallery-controls-row">
        <div class="search-box-wrap">
          <label for="driveSearchInput" class="sr-only">Cari karya desain</label>
          <input
            id="driveSearchInput"
            type="search"
            class="gallery-search-input"
            placeholder="Cari karya (mis. KPU, Kemasan, 3D)..."
            oninput="handleDriveSearch(this.value)"
          />
        </div>
        <div class="view-mode-switch" role="group" aria-label="Mode tampilan galeri">
          <button id="viewGridBtn" type="button" class="view-mode-btn active" onclick="setDriveViewMode('grid', this)">Galeri</button>
          <button id="viewListBtn" type="button" class="view-mode-btn" onclick="setDriveViewMode('list', this)">Daftar</button>
        </div>
      </div>
    </div>

    <div class="skill-bar-wrap">
      <div id="driveFilterBar" class="skill-workbench" role="toolbar" aria-label="Filter kategori karya desain">
        {filters.map((f, i) => (
          <button
            class={`tool-chip${i === 0 ? ' active' : ''}`}
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            onclick={`filterDriveWorks('${f.key}', this)`}
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="discipline-body">
    <!-- INTERACTIVE STAGE PREVIEW -->
    <div class="live-stage spotlight-card">
      <div class="stage-frame stage-clickable" onclick="openCurrentDesignStageModal()" title="Klik untuk memperbesar">
        <img
          id="designStageImg"
          src={firstItem ? `https://drive.google.com/thumbnail?id=${firstItem.id}&sz=w1000` : ''}
          alt={firstItem ? firstItem.title : 'Pratinjau Karya Desain'}
          decoding="async"
        />
      </div>
      <div class="stage-meta-box">
        <span id="designStageBadge" class="stage-badge">{firstItem ? firstItem.tool : 'Adobe Photoshop'}</span>
        <h3 id="designStageTitle" class="stage-info-title">{firstItem ? firstItem.title : ''}</h3>
        <p id="designStageDesc" class="stage-info-desc">{firstItem ? firstItem.desc : ''}</p>
        <div class="stage-repo-actions">
          <button type="button" class="stage-expand-btn magnetic-btn" onclick="openCurrentDesignStageModal()">
            Buka ukuran penuh &nearr;
          </button>
        </div>
      </div>
    </div>

    <!-- EXHIBITION GALLERY WITH HOVER QUICK-ACTION SLIDE -->
    <div class="work-column">
      <div class="work-list-heading">
        <span id="workCountLabel">{items.length} karya ditampilkan</span>
      </div>
      <div id="driveWorkList" class="work-scroll-area grid-mode">
        {items.map((item, idx) => {
          const thumbUrl = `https://drive.google.com/thumbnail?id=${encodeURIComponent(item.id)}&sz=w600`;
          const fallbackThumbUrl = `https://lh3.googleusercontent.com/d/${encodeURIComponent(item.id)}=w600`;
          const actionLabel = item.type === 'video' ? 'Putar Video' : 'Perbesar Karya';
          return (
            <div
              class={`work-row spotlight-card${idx === 0 ? ' is-selected' : ''}`}
              data-drive-idx={idx}
              style={`--stagger-idx: ${idx % 9};`}
              tabindex="0"
              role="button"
              onmouseenter={`previewDesignStageByIndex(${idx})`}
              onfocus={`previewDesignStageByIndex(${idx})`}
              onclick={`openDriveModalByIndex(${idx})`}
              onkeydown={`if(event.key==='Enter'||event.key===' '){event.preventDefault();openDriveModalByIndex(${idx});}`}
            >
              <div class="work-thumb-wrap">
                <img
                  class="work-thumb"
                  src={thumbUrl}
                  onerror={`this.onerror=null;this.src='${fallbackThumbUrl}';`}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                />
                <div class="thumb-hover-drawer">
                  <span>{actionLabel} &nearr;</span>
                </div>
              </div>
              <div class="work-row-info">
                <div class="work-row-name">{item.title}</div>
                <div class="work-row-sub">
                  {item.tool}{item.type === 'video' ? ' · Video' : ''}
                </div>
              </div>
              <span class="work-row-cta">{actionLabel}</span>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
