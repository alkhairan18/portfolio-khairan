---
interface DriveFilter {
  key: string;
  label: string;
}
interface DriveItem {
  id: string;
  cat: string;
  subcat: string;
  isNew: boolean;
  tool: string;
  type: string;
  title: string;
  file: string;
  desc: string;
}
interface Props {
  filters: DriveFilter[];
  items: DriveItem[];
  curatedIds?: string[];
}
const { filters, items, curatedIds = [] } = Astro.props;
const curatedList = curatedIds.length > 0
  ? curatedIds.map(id => items.find(it => it.id === id)).filter(Boolean) as DriveItem[]
  : items.filter(it => (it as any).isCurated);
const firstCurated = curatedList[0] || items[0];
const totalCurated = curatedList.length || 5;
---
<section id="bagian-desain" class="discipline-section">
  <div class="discipline-header">
    <div class="discipline-header-top">
      <div class="discipline-title-stack">
        <h2 class="discipline-title">Graphic Designer Showcase</h2>
        <p class="discipline-lead">
          Kurasi {items.length} karya terpilih meliputi kampanye visual &amp; infografis resmi KPU Kota Makassar, eksplorasi identitas kemasan, ilustrasi vektor, hingga motion graphics dan 3D Blender.
        </p>
      </div>

      <div class="gallery-controls-row">
        <div class="search-box-wrap">
          <label for="driveSearchInput" class="sr-only">Cari karya desain</label>
          <input
            id="driveSearchInput"
            type="search"
            class="gallery-search-input"
            placeholder="Cari karya (mis. KPU, Kemasan, 3D)..."
          />
        </div>
        <div class="view-mode-switch" role="group" aria-label="Mode tampilan galeri">
          <button id="viewGridBtn" type="button" class="view-mode-btn active" data-action="view-mode" data-mode="grid">Bento Galeri</button>
          <button id="viewListBtn" type="button" class="view-mode-btn" data-action="view-mode" data-mode="list">Indeks Katalog</button>
        </div>
      </div>
    </div>

    <div class="skill-bar-wrap">
      <div id="driveFilterBar" class="skill-workbench" role="toolbar" aria-label="Filter kategori karya desain">
        {filters.map((f, i) => (
          <button
            class={`tool-chip${i === 0 ? ' active' : ''}`}
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-action="filter-drive"
            data-key={f.key}
          >
            {f.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="discipline-body">
    <!-- CINEMA FEATURED EXHIBITION STAGE -->
    <div class="live-stage spotlight-card">
      <div class="stage-topbar">
        <div class="stage-topbar-left">
          <span class="stage-live-dot"></span>
          <span>Karya Pilihan Unggulan</span>
        </div>
        <div class="stage-topbar-controls">
          <span id="designStageCounter" class="stage-counter-pill">1 / {totalCurated}</span>
          <button
            id="stageVideoToggleBtn"
            type="button"
            class="stage-step-btn stage-video-toggle"
            data-action="toggle-stage-video"
            aria-label="Jeda video animasi 3D"
            title="Jeda animasi 3D"
          >
            <svg class="video-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="6" y="4" width="4" height="16" rx="1"></rect>
              <rect x="14" y="4" width="4" height="16" rx="1"></rect>
            </svg>
            <span class="video-toggle-label">Jeda</span>
          </button>
          <button type="button" class="stage-step-btn" data-action="step-stage" data-delta="-1" aria-label="Karya pilihan sebelumnya">&larr; Prev</button>
          <button type="button" class="stage-step-btn" data-action="step-stage" data-delta="1" aria-label="Karya pilihan berikutnya">Next &rarr;</button>
        </div>
      </div>

      <div class="stage-main-split">
        <div class="stage-frame stage-clickable" data-action="open-stage" title="Klik untuk membuka studi kasus lengkap">
          <video
            id="designStageVideo"
            class="stage-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/assets/animacion-3d-aerodinamica-f1-poster.jpg"
            width="854"
            height="480"
            aria-label="Animasi 3D Studio"
          >
            <source src="/assets/animacion-3d-aerodinamica-f1.webm" type="video/webm" />
          </video>
          <img
            id="designStageImg"
            src={firstCurated ? `/assets/works/${firstCurated.id}-1200.webp` : ''}
            onerror={firstCurated ? `this.onerror=null;this.src='https://drive.google.com/thumbnail?id=${firstCurated.id}&sz=w1200';` : undefined}
            alt={firstCurated ? firstCurated.title : 'Pratinjau Karya Desain'}
            decoding="async"
            style="display:none;"
          />
        </div>
        <div class="stage-meta-box">
          <h3 id="designStageTitle" class="stage-info-title">{firstCurated ? firstCurated.title : ''}</h3>
          <div class="stage-badge-row">
            <span id="designStageBadge" class="stage-badge">{firstCurated ? firstCurated.tool : 'Adobe Photoshop'}</span>
            <span class="stage-format-tag">Kurasi Unggulan</span>
          </div>
          <p id="designStageDesc" class="stage-info-desc">{firstCurated ? firstCurated.desc : ''}</p>
          <div class="stage-repo-actions">
            <button type="button" class="stage-expand-btn magnetic-btn" data-action="open-stage">
              Lihat Studi Kasus Lengkap &nearr;
            </button>
            <button type="button" class="stage-next-outline-btn" data-action="step-stage" data-delta="1">
              Karya Berikutnya &rarr;
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- ASYMMETRIC EXHIBITION GALLERY -->
    <div class="work-column">
      <div class="work-list-heading">
        <div class="work-list-heading-left">
          <span class="heading-dot"></span>
          <span id="workCountLabel">{items.length} karya ditampilkan</span>
        </div>
        <span class="work-list-hint">Pilih kartu untuk melihat detail dan dokumentasi visual</span>
      </div>
      <div id="driveWorkList" class="work-scroll-area grid-mode">
        {items.map((item, idx) => {
          const thumbUrl = `/assets/works/${item.id}-600.webp`;
          const fallbackThumbUrl = `https://drive.google.com/thumbnail?id=${encodeURIComponent(item.id)}&sz=w600`;
          const actionLabel = item.type === 'video' ? 'Putar Video' : 'Perbesar Karya';
          return (
            <div
              class={`work-row spotlight-card is-initial-reveal${idx === 0 ? ' is-selected' : ''}`}
              data-drive-idx={idx}
              style={`--stagger-idx: ${idx % 9};`}
            >
              <div class="work-card-top">
                <span class="work-card-type">{item.tool}</span>
                {item.type === 'video' && <span class="work-card-format">Motion Video</span>}
              </div>
              <div class="work-thumb-wrap" data-action="open-work" data-idx={idx}>
                <img
                  class="work-thumb"
                  src={thumbUrl}
                  onerror={`this.onerror=null;this.src='${fallbackThumbUrl}';`}
                  alt={item.title}
                  loading="lazy"
                  decoding="async"
                />
                <div class="thumb-hover-drawer">
                  <span>{actionLabel} &nearr;</span>
                </div>
              </div>
              <div class="work-row-info">
                <div class="work-row-text">
                  <div class="work-row-name">
                    <button type="button" class="work-open" data-action="open-work" data-idx={idx}>
                      {item.title}
                    </button>
                  </div>
                  <div class="work-row-sub">
                    {item.tool}{item.type === 'video' ? ' · Video' : ''}
                  </div>
                </div>
                <span class="work-arrow-icon" aria-hidden="true">&nearr;</span>
              </div>
              <button type="button" class="work-row-cta" data-action="open-work" data-idx={idx}>{actionLabel}</button>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
