---
interface Props {
  name: string;
  avatarUrl: string;
  designCount: number;
}
const { name, avatarUrl, designCount } = Astro.props;
---
<header class="nav">
  <a href="#perkenalan" class="nav-brand">
    <span class="nav-status-dot" aria-hidden="true"></span>
    <img class="nav-avatar" src={avatarUrl} alt={name} />
    <div class="nav-brand-text">
      <span>{name}</span>
      <small class="nav-brand-sub">STUDIO ARCHIVE // MAKASSAR, ID</small>
    </div>
  </a>
  <div class="nav-right">
    <nav class="nav-links" aria-label="Navigasi Utama">
      <a href="#perkenalan"><span class="nav-idx">00</span> Profil</a>
      <a href="#bagian-desain"><span class="nav-idx">01</span> Karya ({designCount})</a>
      <a href="#bagian-development"><span class="nav-idx">02</span> Software Dev</a>
      <a href="#kontak"><span class="nav-idx">03</span> Kontak</a>
    </nav>
    <div class="nav-actions">
      <button id="themeToggleBtn" class="theme-toggle-btn" type="button" onclick="toggleTheme()">
        Mode Terang
      </button>
      <a href="#kontak" class="nav-cta-pill">Kolaborasi &nearr;</a>
    </div>
  </div>
</header>
