---
import '../styles/global.css';
import PORTFOLIO_DATA from '../data/portfolio-data.cjs';

const { profile } = PORTFOLIO_DATA;
---
<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404: Halaman Tidak Ditemukan - {profile.name}</title>
  <meta name="robots" content="noindex, follow" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script defer src="/_vercel/insights/script.js"></script>
  <style>
    .error-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px 24px;
      text-align: center;
      background: var(--bg);
      color: var(--text);
    }
    .error-card {
      max-width: 640px;
      padding: 48px 36px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      box-shadow: 0 20px 48px rgba(0, 0, 0, 0.28);
    }
    .error-code {
      font-family: var(--font-mono);
      font-size: 14px;
      font-weight: 700;
      color: var(--accent);
      letter-spacing: 0.12em;
      margin-bottom: 16px;
    }
    .error-title {
      font-family: var(--font-serif);
      font-size: clamp(38px, 6vw, 64px);
      font-weight: 400;
      line-height: 1.1;
      margin-bottom: 20px;
      color: var(--text);
    }
    .error-lead {
      font-family: var(--font-sans);
      font-size: 16px;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 32px;
    }
    .error-home-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 28px;
      border-radius: var(--radius-pill);
      background: var(--accent);
      color: var(--on-accent);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 13.5px;
      font-weight: 700;
      letter-spacing: 0.02em;
      transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .error-home-btn:hover {
      background: var(--accent-hover);
      transform: translateY(-2px);
    }
  </style>
</head>
<body>
  <div class="error-shell">
    <div class="error-card">
      <div class="error-code">404 // INDEX ERROR</div>
      <h1 class="error-title">Halaman <span class="serif-italic">Tidak Ditemukan</span></h1>
      <p class="error-lead">
        Halaman atau rute arsip yang Anda cari tidak tersedia atau telah dipindahkan ke kurasi portofolio utama.
      </p>
      <a href="/" class="error-home-btn">
        Kembali ke Beranda Portofolio &rarr;
      </a>
    </div>
  </div>
</body>
</html>
